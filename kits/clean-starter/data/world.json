 "BOSS_LORE": {
  "bossJelly": {
   "t": "Mẹ của Ánh Trăng Đáy Biển",
   "l": "Đêm trăng đầu tiên rọi tới đáy biển, một tia sáng kết lại thành viên ngọc trai sống. Viên ngọc nở ra Sứa Mẫu Hậu, mẹ của mọi loài sứa lân quang ở Bãi San Hô. Bà ngự trên ngai san hô, vương miện kết từ ngọc trai của những thủy thủ chết đuối. Khi bà hát khúc thủy triều, cả bãi san hô bừng sáng, và ai nghe trọn khúc ca sẽ quên đường về mặt nước."
  },
  "bossFishNight": {
   "t": "Kẻ Nuốt Sao",
   "l": "Chúa tể của vùng nước không có ánh sáng. Ngọn đèn treo trước miệng Dạ Vương là linh hồn một vì sao rơi xuống biển thời khai thiên, bị nó nuốt nửa chừng rồi giữ lại làm mồi. Cá nhỏ lao theo ánh sáng ấy chưa con nào trở về. Mỗi chiếc gai pha lê trên lưng nó là vương miện của một kẻ thách đấu đã bại."
  },
  "bossFish": {
   "t": "Vua Rêu Ba Nghìn Năm",
   "l": "Ba nghìn năm Lục Vương không rời Rừng Tảo U Linh. Rêu mọc kín lưng, tảo kết thành áo choàng, gai độc dài như giáo của đội hải binh đã chìm cùng chiến thuyền. Người chài kể rằng mỗi lần nó xòe gai, cả khu rừng tảo cúi rạp như thần dân trước nhà vua."
  },
  "bossKelpSerpent": {
   "t": "Kẻ Canh Rễ Tảo Mẹ",
   "l": "Con rắn biển canh giữ rễ của Cây Tảo Mẹ, nơi linh hồn người chết đuối trôi về yên nghỉ. Bờm nó là tảo u linh, mỗi sợi phát sáng là một hồn người nó che chở. Khi Hải Xà Vương cuộn mình, hải lưu đổi hướng và cả khu rừng chìm vào bóng tối xanh thẫm."
  },
  "bossLava": {
   "t": "Trái Tim Núi Lửa Đáy Biển",
   "l": "Khi núi lửa dưới biển phun trào lần đầu, một con sứa nhỏ bị cuốn vào dòng dung nham mà không chết. Nó nuốt lửa thay cho nước, lớn dần thành Sứa Hỏa Vương. Vòm thân là đá vỏ chai đã nguội, trái tim là lõi dung nham không bao giờ tắt. Xúc tu của nó lướt qua đâu, nước biển sôi thành hơi ở đó."
  },
  "bossFlame": {
   "t": "Vị Thần Bị Xiềng",
   "l": "Thần lửa thời cổ bị các thần biển xiềng dưới đáy Hố Thẳm vì muốn thiêu khô đại dương. Xiềng xích từ lâu đã chảy thành dung nham, nhưng thần vẫn ngủ, chờ gom đủ lửa để trở lại mặt đất. Mỗi kẻ xuống đây giao chiến là thêm một ngọn lửa đánh thức ngài."
  },
  "bossApep": {
   "t": "Kẻ Nuốt Mặt Trời",
   "l": "Apophis là con rắn hỗn mang, đêm nào cũng tìm cách nuốt thái dương trên đường về phương đông. Các pharaoh đã giam nó dưới cát vàng bằng một nghìn phong ấn khắc trên vách đền. Bão cát đã mài mòn phong ấn cuối cùng; nay cứ mỗi lần mặt trời lặn, sa mạc lại rung lên tiếng rít của nó."
  },
  "bossMummy": {
   "t": "Vị Vua Không Chết",
   "l": "Vị pharaoh từng ra lệnh cho gió sa mạc phải dừng. Ngài đổi linh hồn lấy sự bất tử, và cái giá là đời đời canh giữ kho báu trong lăng mộ của chính mình. Băng vải của ngài tẩm nhựa thánh, bừng sáng mỗi khi có kẻ trộm bước qua ngưỡng cửa."
  },
  "bossTitan": {
   "t": "Người Gác Cổng Olympus",
   "l": "Khi các Titan thua trận trước chư thần Olympus, kẻ mạnh nhất trong số họ bị Zeus hóa thành cẩm thạch và dựng ở cổng Thánh Địa làm người gác. Hàng nghìn năm sét đánh xuống đã nạp lại sức mạnh cho Titan. Những vết nứt vàng trên thân là máu thần đang thức tỉnh."
  },
  "bossHydra": {
   "t": "Ác Quỷ Không Thể Giết",
   "l": "Quái vật mà Heracles từng chặt đầu: mỗi cái đầu rơi xuống đầm Lerna lại mọc thành hai. Chư thần Olympus giam nó dưới chân Thánh Địa như một lời răn rằng có những ác quỷ không bao giờ chết hẳn, chỉ có thể bị canh giữ."
  }
 },
